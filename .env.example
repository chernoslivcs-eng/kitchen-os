# Anthropic API key — required for the eval runner to actually call the model.
# Without it the runner prints "SKIPPED (no API key)" for every case and only
# validates the prompt-version registry loads cleanly.
ANTHROPIC_API_KEY=

# Optional: which prompt version to use for a run.
# Defaults to the newest folder under packages/prompts/versions/.
PROMPT_VERSION=

# Optional: model overrides. Defaults match packages/model-client/profiles.ts.
MODEL_FAST=claude-haiku-4-5-20251001
MODEL_SMART=claude-sonnet-5

# Postgres (production). Neon pooled connection string for production database.
# Set for the api service to use PostgresRepo; leave empty for InMemory.
# Local Docker option: `docker compose up -d postgres` на порту 5433
# PG_URL=postgresql://kitchen:kitchen@localhost:5433/kitchen
PG_URL=postgresql://neondb_owner:[password]@ep-gentle-waterfall-zart3k1z-pooler.c-2.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Postgres для тестів packages/db (Neon dev branch, не PG_URL — щоб не пекти прод-базу).
# Якщо не задано і Docker недоступний — тести PostgresRepo скіпляються з причиною.
PG_TEST_URL=postgresql://neondb_owner:[password]@ep-round-dream-zau0u584-pooler.c-2.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
