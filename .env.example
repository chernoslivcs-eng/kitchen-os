# Anthropic API key — required for the eval runner to actually call the model.
# Without it the runner prints "SKIPPED (no API key)" for every case and only
# validates the prompt-version registry loads cleanly.
ANTHROPIC_API_KEY=

# Optional: which prompt version to use for a run.
# Defaults to the newest folder under packages/prompts/versions/.
PROMPT_VERSION=

# Optional: model overrides. Дефолти залежать від провайдера — див. services/api/src/model.ts.
# OpenRouter слаги: `curl https://openrouter.ai/api/v1/models | jq -r '.data[].id | select(startswith("anthropic/"))'`.
MODEL_FAST=anthropic/claude-haiku-4.5
MODEL_SMART=anthropic/claude-sonnet-4.5

# Postgres (production). Neon pooled connection string for production database.
# Set for the api service to use PostgresRepo; leave empty for InMemory.
# Local Docker option: `docker compose up -d postgres` на порту 5433
# PG_URL=postgresql://kitchen:kitchen@localhost:5433/kitchen
PG_URL=postgresql://neondb_owner:[password]@ep-gentle-waterfall-zart3k1z-pooler.c-2.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Postgres для тестів packages/db (Neon dev branch, не PG_URL — щоб не пекти прод-базу).
# Якщо не задано і Docker недоступний — тести PostgresRepo скіпляються з причиною.
PG_TEST_URL=postgresql://neondb_owner:[password]@ep-round-dream-zau0u584-pooler.c-2.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Пошта. Якщо SMTP_HOST не задано — стаб-мейлер (лог у stdout).
# Працює з Resend SMTP, Amazon SES SMTP, будь-яким SMTP-хостом.
# Приклад для Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_USER=resend, SMTP_PASS=<api-key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Кухня <no-reply@your-domain.example>

# Базовий URL для лінків у листах. У проді — https://kos.app або що там буде.
APP_URL=http://localhost:3000

# --- Vercel-only env vars (у .env локально не потрібні, тримати в Vercel Env dashboard) ---

# Vercel Blob для attachments. Без цього серверлес-функція намагатиметься писати
# на read-only ФС і завалиться на першому фото. Взяти можна тут:
# https://vercel.com/dashboard/stores -> Create -> Blob.
BLOB_READ_WRITE_TOKEN=

# Vercel сам виставляє NODE_ENV=production. Не додавай його вручну в dashboard —
# перекриє default. Просто памʼятай: cookies secure=true увімкнеться автоматично.
