{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@kitchen/web",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@kitchen/api",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "api-mem",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PG_URL=",
        "pnpm",
        "--filter",
        "@kitchen/api",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "api-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PG_URL=",
        "OPENROUTER_API_KEY=",
        "ANTHROPIC_API_KEY=",
        "pnpm",
        "--filter",
        "@kitchen/api",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "api-gemini",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PG_URL=",
        "MODEL_SMART=google/gemini-3.8-flash",
        "pnpm",
        "--filter",
        "@kitchen/api",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "api-demo-3010",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PG_URL=",
        "OPENROUTER_API_KEY=",
        "ANTHROPIC_API_KEY=",
        "PORT=3010",
        "APP_URL=http://localhost:5180",
        "pnpm",
        "--filter",
        "@kitchen/api",
        "start"
      ],
      "port": 3010
    },
    {
      "name": "web-5180",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_URL=http://localhost:3010",
        "pnpm",
        "--filter",
        "@kitchen/web",
        "dev",
        "--",
        "--port",
        "5180"
      ],
      "port": 5180
    }
  ]
}
