{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@kitchen/web", "dev"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@kitchen/api", "start"],
      "port": 3000
    },
    {
      "name": "api-mem",
      "runtimeExecutable": "env",
      "runtimeArgs": ["PG_URL=", "pnpm", "--filter", "@kitchen/api", "start"],
      "port": 3000
    }
  ]
}
