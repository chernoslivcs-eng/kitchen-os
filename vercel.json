{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 120,
      "memory": 1024,
      "includeFiles": "{apps/web/dist/spa.html,api-dist/**}"
    },
    "api/telegram.ts": {
      "maxDuration": 120,
      "memory": 1024,
      "includeFiles": "api-dist/**"
    },
    "api/cron-digest.ts": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "api-dist/**"
    },
    "api/cron-billing.ts": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "api-dist/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron-digest",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron-billing",
      "schedule": "30 3 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "kitchen-os-coral.vercel.app"
        }
      ],
      "destination": "https://kitchen-os.app/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/r/:id",
      "destination": "/api/index"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|bingbot|DuckDuckBot|YandexBot|facebookexternalhit|Twitterbot|TelegramBot|Slackbot|LinkedInBot|WhatsApp|Discordbot).*"
        }
      ],
      "destination": "/prerendered/index.html"
    },
    {
      "source": "/terms",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|bingbot|DuckDuckBot|YandexBot|facebookexternalhit|Twitterbot|TelegramBot|Slackbot|LinkedInBot|WhatsApp|Discordbot).*"
        }
      ],
      "destination": "/prerendered/terms.html"
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|bingbot|DuckDuckBot|YandexBot|facebookexternalhit|Twitterbot|TelegramBot|Slackbot|LinkedInBot|WhatsApp|Discordbot).*"
        }
      ],
      "destination": "/prerendered/privacy.html"
    },
    {
      "source": "/refund",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|bingbot|DuckDuckBot|YandexBot|facebookexternalhit|Twitterbot|TelegramBot|Slackbot|LinkedInBot|WhatsApp|Discordbot).*"
        }
      ],
      "destination": "/prerendered/refund.html"
    },
    {
      "source": "/contacts",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|bingbot|DuckDuckBot|YandexBot|facebookexternalhit|Twitterbot|TelegramBot|Slackbot|LinkedInBot|WhatsApp|Discordbot).*"
        }
      ],
      "destination": "/prerendered/contacts.html"
    },
    {
      "source": "/((?!assets|fonts/|email/|manifest.webmanifest|icon.svg|sw.js|robots.txt|sitemap.xml|prerendered/|api/).*)",
      "destination": "/spa.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=()"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.public.blob.vercel-storage.com; media-src 'self' https://*.public.blob.vercel-storage.com; connect-src 'self' https://*.ingest.de.sentry.io; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
