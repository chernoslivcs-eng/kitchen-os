{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @kitchen/db migrate && pnpm --filter @kitchen/web build",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 120,
      "memory": 1024,
      "includeFiles": "apps/web/dist/index.html"
    }
  },
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/r/:id", "destination": "/api/index" },
    { "source": "/((?!assets|manifest.webmanifest|icon.svg|api/).*)", "destination": "/index.html" }
  ]
}
